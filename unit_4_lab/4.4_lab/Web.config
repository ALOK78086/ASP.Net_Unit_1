<?xml version="1.0"?>
<configuration>
  <connectionStrings>
    <add name="MyDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=LabDB;Integrated Security=True"
         providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.7.2"/>
  </system.web>
</configuration>
